# Variáveis de ambiente do VexOS (configurar na Vercel, nunca commitar)
#
# Copie para .env.local se for rodar `vercel dev` na sua máquina.
# O .gitignore já impede o .env.local de ser versionado.

# ---- Supabase ----
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chave publicável (sb_publishable_...). Vai para o navegador de
# propósito — quem protege os dados é o RLS, não ela.
SUPABASE_ANON_KEY=
# SEGREDO. Ignora RLS por completo. Só o backend usa.
SUPABASE_SERVICE_KEY=

# ---- Mercado Pago (aplicação VexOS Assinaturas) ----
# SEGREDO. Movimenta dinheiro na conta.
MP_ACCESS_TOKEN=
# SEGREDO. Sem ele, qualquer um forja notificação e libera assinatura.
# Token e segredo TÊM que vir do mesmo modo: os dois de teste, ou os
# dois de produção. Misturar devolve 401 em toda notificação.
MP_WEBHOOK_SECRET=

# ---- Endereço público ----
# Retorno do checkout e notification_url do PIX.
VEXOS_URL=https://vexos-bay.vercel.app
